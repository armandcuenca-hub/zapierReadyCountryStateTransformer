// Build lookup maps
const countryByAlpha2 = new Map(COUNTRIES.map(c => [c[0], c[2]]));
const countryByAlpha3 = new Map(COUNTRIES.map(c => [c[1], c[2]]));
const alpha3ToAlpha2 = new Map(COUNTRIES.map(c => [c[1], c[0]]));

const stateByCountryAndCode = new Map();
for (const [countryA2, states] of Object.entries(STATES_BY_COUNTRY)) {
  stateByCountryAndCode.set(countryA2, new Map(states));
}

function getCountryName(code) {
  if (!code) return null;
  const c = String(code).trim().toUpperCase();
  if (c.length === 2) return countryByAlpha2.get(c) || null;
  if (c.length === 3) return countryByAlpha3.get(c) || null;
  return null;
}

function toAlpha2(code) {
  if (!code) return null;
  const c = String(code).trim().toUpperCase();
  if (c.length === 2) return countryByAlpha2.has(c) ? c : null;
  if (c.length === 3) return alpha3ToAlpha2.get(c) || null;
  return null;
}

function getStateName(countryCode, stateCode) {
  if (!countryCode || !stateCode) return null;
  const countryA2 = toAlpha2(countryCode);
  if (!countryA2) return null;
  const stateMap = stateByCountryAndCode.get(countryA2);
  if (!stateMap) return null;
  return stateMap.get(String(stateCode).trim().toUpperCase()) || null;
}

// Main transformation using input data - changeable according to Zapier input data
