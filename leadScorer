const companyName = inputData.company || '';
const jobTitle = inputData.job_title || '';
const companySizeStr = inputData.company_size || '0';

// Normalize company name for matching
function normalizeCompanyName(name) {
  return String(name).trim().toLowerCase().replace(/\./g, '').replace(/,/g, '').replace(/\s+/g, ' ');
}

const companySizeNum = parseInt(companySizeStr, 10) || 0;

// 1) Calculate company score - check if matches S&P 500
const normalizedInput = normalizeCompanyName(companyName);
const normalizedSP500 = SP500_COMPANIES.map(c => normalizeCompanyName(c));
const isSP500 = normalizedSP500.includes(normalizedInput);
const companyScore = isSP500 ? 20 : 10;

// 2) Calculate job title score
const jobTitleLower = jobTitle.toLowerCase();
let jobTitleScore = 5; // default

if (/\b(ceo|owner|chairman|chairwoman|chairperson|chief executive officer)\b/.test(jobTitleLower)) {
  jobTitleScore = 30;
} else if (/\b(cfo|coo|cto|president|vp|vice president|chief financial officer|chief operating officer|chief technology officer)\b/.test(jobTitleLower)) {
  jobTitleScore = 20;
} else if (/\b(manager|director|team lead)\b/.test(jobTitleLower)) {
  jobTitleScore = 10;
} else if (/\b(specialist|analyst|assistant)\b/.test(jobTitleLower)) {
  jobTitleScore = 5;
}

// 3) Calculate company size score
let companySizeScore = 5;

if (companySizeNum >= 1000) {
  companySizeScore = 30;
} else if (companySizeNum >= 500) {
  companySizeScore = 20;
} else if (companySizeNum >= 100) {
  companySizeScore = 15;
} else if (companySizeNum >= 50) {
  companySizeScore = 10;
} else if (companySizeNum >= 10) {
  companySizeScore = 5;
}

// Calculate total lead score
const totalLeadScore = companyScore + jobTitleScore + companySizeScore;

return {
  total_lead_score: totalLeadScore,
  company_score: companyScore,
  job_title_score: jobTitleScore,
  company_size_score: companySizeScore
};
